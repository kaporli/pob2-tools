          "text": "\tname = \"Culmination II\","
        },
        {
          "n": 1631,
          "text": "\tdescription = \"Supports Melee Attack Skills. Supported Skills gain Combo when you successfully Strike Enemies with other Melee Attacks. Supported Skills reset their Combo on use, dealing more Damage the higher Combo you had on use. Cannot support skills which already gain Combo. Cannot modify the Skills of Minions.\","
        },
        {
          "n": 1633,
          "text": "\tsupport = true,"
        },
        {
          "n": 1634,
          "text": "\trequireSkillTypes = { SkillType.Attack, SkillType.Melee, SkillType.AND, },"
        },
        {
          "n": 1635,
          "text": "\taddSkillTypes = { SkillType.ComboStacking, SkillType.SupportedByComboMastery, SkillType.HasUsageCondition, },"
        },
        {
          "n": 1636,
          "text": "\texcludeSkillTypes = { SkillType.HasUsageCondition, SkillType.SupportedByComboMastery, SkillType.NOT, SkillType.AND, },"
        },
        {
          "n": 1649,
          "text": "\t\t\t\t{ \"support_culmination_damage_+%_final_per_combo_stack\", 4 },"
        },
