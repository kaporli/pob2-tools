 "gaps": [
  {
   "collection_method": "source lookup",
   "explanation": "Upstream records 24 weapon-set passive points across 12 quest rewards, each with the level of the area the quest is in. An area level is not the character level at which the reward is obtainable, so the budget is exported as a total and not as a schedule.",
   "gap_id": "gap/p02-t02/weapon-set-point-unlock-levels",
   "kind": "unsupported_rule",
   "needed_evidence": "for each quest that grants weapon-set passive skill points in the resolved patch, the quest name, the act and the minimum character level at which a character can complete it, from the official patch notes or the in-game quest list",
   "severity": "informational"
  },
  {
   "collection_method": "source lookup",
   "explanation": "No entry in the engine's quest reward data grants ordinary passive skill points: the point-granting entries all grant weapon-set passive points. The exported budget therefore counts levelling points only, and a character's real passive total is higher by an unknown amount. The legacy pob2opt/cli.py estimate of (level - 1) + 8 is not sourced from anything and is deliberately not promoted to a rule here.",
   "gap_id": "gap/p02-t02/quest-passive-point-rewards",
   "kind": "unsupported_rule",
   "needed_evidence": "the list of quests granting ordinary passive skill points in the resolved patch, each with its act, the quest name and the number of points granted, from the official patch notes or the in-game quest reward screen",
   "severity": "ranking_sensitive"
  },
  {
   "collection_method": "source lookup",
   "explanation": "Upstream carries the ascendancy point maximum (8) but no rule for when each point is earned. The only progression hint in the engine is a labyrinth suggestion its own comment calls a recommendation for beginners. A build below the maximum therefore has no sourced budget.",
   "gap_id": "gap/p02-t02/ascendancy-point-unlock-schedule",
   "kind": "unsupported_rule",
   "needed_evidence": "for the resolved patch, each trial or quest that grants ascendancy points, the number granted and the minimum character level at which it can be completed, from the official patch notes",
   "severity": "ranking_sensitive"
  },
  {
   "collection_method": "engine implementation",
   "explanation": "The engine's slot table names 113 slots and which of them belong to a weapon set. It does not say which item base categories each slot accepts, so every exported slot rule has an empty category list and equipment legality cannot be decided from this profile.",
   "gap_id": "gap/p02-t02/slot-accepted-base-categories",
   "kind": "missing_input",
   "needed_evidence": "for each equipment slot, the set of item base types it accepts and the hand or slot conflicts it creates, read from the engine's own item-to-slot matching code and confirmed against one fixture item per base type",
   "severity": "blocking"
  },
  {
   "collection_method": "engine implementation",
   "explanation": "gem_level_limit is the highest natural maximum level in the engine's gem data (20). It is not a legality cap: items and passives grant levels above a gem's natural maximum, and upstream carries no single number for the highest legal level.",
   "gap_id": "gap/p02-t02/gem-level-legality",
   "kind": "unsupported_rule",
   "needed_evidence": "the rule relating a gem's natural maximum level to the highest level it can reach with item and passive grants in the resolved patch, confirmed with one fixture build per grant source",
   "severity": "informational"
  },
  {
   "collection_method": "source lookup",
   "explanation": "The engine carries per-skill level tables but no character-facing limit on a skill's level that is separate from its gem, so skill_level_limit is exported as unknown.",
   "gap_id": "gap/p02-t02/skill-level-limit",
   "kind": "missing_input",
   "needed_evidence": "whether the resolved patch caps an active skill's level independently of its gem level, and the cap if it does, from the official patch notes",
   "severity": "informational"
  },
  {
   "collection_method": "source lookup",
   "explanation": "The engine data release is dated 2026-07-28 and patch 0.5.5e was published 2026-10-06, so any entity, skill or modifier that patch introduced is absent from this catalog. The export cannot list what is missing, only that something is.",
   "gap_id": "gap/p02-t02/catalog-predates-current-patch",
   "kind": "stale_patch",
   "needed_evidence": "the official patch notes for every patch published after 2026-07-28, listing added or changed classes, ascendancies, skills, support gems and item bases, and a Path of Building release that includes them",
   "severity": "ranking_sensitive"
  }
 ],
