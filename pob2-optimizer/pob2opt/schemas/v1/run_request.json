{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pob2-tools.invalid/schemas/v1/run_request.json",
  "title": "RunRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "game": {
      "type": "string",
      "const": "poe2"
    },
    "class": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "patch_selection": {
      "type": "string"
    },
    "league_selection": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "market",
        "offline_items",
        "theoretical"
      ]
    },
    "budget": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?\\d+(\\.\\d+)?$"
    },
    "scenario_suite": {
      "type": "string"
    },
    "catalog_profile": {
      "type": "string"
    },
    "corpus_path": {
      "type": "string"
    },
    "item_pool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "time_budget_s": {
      "type": "integer",
      "minimum": 0
    },
    "workers": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "auto"
        }
      ]
    },
    "memory_limit_mb": {
      "type": "integer",
      "minimum": 0
    },
    "allow_weapon_switch": {
      "type": "boolean"
    },
    "allow_external_gear_swap": {
      "type": "boolean"
    },
    "execution_profile": {
      "type": "string"
    },
    "class_scope": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClassScope"
      }
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveSelection"
    }
  },
  "required": [
    "schema_version",
    "game",
    "level",
    "patch_selection",
    "league_selection",
    "mode",
    "budget",
    "scenario_suite",
    "catalog_profile",
    "corpus_path",
    "item_pool_ids",
    "seed",
    "time_budget_s",
    "workers",
    "memory_limit_mb",
    "allow_weapon_switch",
    "allow_external_gear_swap",
    "execution_profile"
  ],
  "additionalProperties": false,
  "description": "The request file of interfaces.md. Not a persisted domain record.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "exclusiveMinimum": 1
          }
        }
      },
      "then": {
        "required": [
          "class_scope",
          "objective"
        ],
        "properties": {
          "class": false
        }
      },
      "else": {
        "properties": {
          "class_scope": false,
          "objective": false
        },
        "required": [
          "class"
        ]
      }
    }
  ],
  "$defs": {
    "ClassScope": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "ascendancy_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "class_id",
        "ascendancy_ids"
      ],
      "additionalProperties": false,
      "description": "One approved class of a RunRequest version 2 campaign."
    },
    "ObjectiveSelection": {
      "type": "object",
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_version": {
          "type": "integer",
          "minimum": 1
        },
        "target_skill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benchmark_scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_scenario_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "attribution_rules": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution_rules_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "objective_id",
        "objective_version",
        "target_skill_ids",
        "benchmark_scenario",
        "benchmark_scenario_hash",
        "attribution_rules",
        "attribution_rules_hash"
      ],
      "additionalProperties": false,
      "description": "The objective a RunRequest version 2 optimizes (D07)."
    }
  }
}
