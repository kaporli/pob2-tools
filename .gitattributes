# Default: let git normalize line endings in text files it manages.
* text=auto

# Fixtures are content-addressed. tests/fixtures/manifest.json records a
# SHA-256 per file and tests/unit/test_fixture_manifest.py verifies it, so the
# bytes checked out must be the bytes that were committed. Without `-text`,
# core.autocrlf rewrites LF to CRLF on a Windows checkout and every recorded
# hash breaks - which is exactly what the first CI run caught.
tests/fixtures/** -text

# The Lua probe is executed by a luajit subprocess; keep its bytes stable too.
tests/integration/lua/*.lua -text

# Official pages captured byte for byte (P02-T02.1). Their SHA-256 is recorded
# beside them, so line endings must not be rewritten.
docs/evidence/P02/release/*.html -text
docs/evidence/P02-T02.1/official/** -text

# P09-T01.1 suite and seed export. SHA-256 of these files is frozen in
# benchmarks/p09-flicker-v1/suite.json and seed/manifest.json.
benchmarks/p09-flicker-v1/** -text
docs/evidence/P09-T01.1/** -text

# P09-T01.2 evidence. mechanics-rules.json records the SHA-256 of replay.json
# and web-evidence.json.
docs/evidence/P09-T01.2/** -text

# P07-T01 evidence. Its README records the SHA-256 of the JSON files.
docs/evidence/P07-T01/** -text

# P07-T01 attribution table. table_hash is recorded inside it.
benchmarks/p09-flicker-v1-attribution/** -text

# Historical review bundles published with the GitHub tracking migration.
# Preserve their recorded SHA-256 values on Windows checkouts.
docs/evidence/PR-18-22/** -text whitespace=cr-at-eol
docs/evidence/PR-19-22-rereview/** -text whitespace=cr-at-eol
docs/evidence/PR-19-22-final-review/** -text whitespace=cr-at-eol
